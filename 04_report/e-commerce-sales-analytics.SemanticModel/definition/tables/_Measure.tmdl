	measure 'NTV Text' =
			VAR _v = [Net Transaction Value]
			RETURN
			    "₹"
			        & SWITCH (
			            TRUE (),
			            _v >= 1e9, FORMAT ( _v / 1e9, "0.00" ) & "bn",
			            _v >= 1e6, FORMAT ( _v / 1e6, "#,0" ) & "M",
			            FORMAT ( _v / 1e3, "#,0.0" ) & "K"
			        )
		displayFolder: 4 Titles
		lineageTag: 09fce72e-4b89-44f1-b29a-42e96f98bc28

	measure 'Exec Headline' =
			
			VAR _cap = EDATE ( [Last Sale Date], -12 )
			VAR _cs = [Comparable Start]
			VAR _cur = [Net Transaction Value]
			VAR _curC = CALCULATE ( [Net Transaction Value], KEEPFILTERS ( Dim_Date[Date] >= _cs ) )
			VAR _py = CALCULATE ( [Net Transaction Value], SAMEPERIODLASTYEAR ( Dim_Date[Date] ), KEEPFILTERS ( Dim_Date[Date] <= _cap ) )
			VAR _partial = MIN ( Fact_Sales[order_date] ) < _cs
			VAR _subject =
			    IF (
			        _partial,
			        CALCULATE ( [Selected Period Text], KEEPFILTERS ( Dim_Date[Date] >= _cs ) ) & " revenue",
			        "Revenue"
			    )
			VAR _amount =
			    IF ( _partial, CALCULATE ( [NTV Text], KEEPFILTERS ( Dim_Date[Date] >= _cs ) ), [NTV Text] )
			VAR _g = DIVIDE ( _curC - _py, _py )
			VAR _first =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _py ), "Revenue reached " & [NTV Text] & " in " & [Selected Period Text],
			        ABS ( _g ) < 0.01, _subject & " held flat at " & _amount & " " & [PY Period Label],
			        _g > 0, _subject & " grew " & FORMAT ( _g, "0.0%" ) & " to " & _amount & " " & [PY Period Label],
			        _subject & " fell " & FORMAT ( -_g, "0.0%" ) & " to " & _amount & " " & [PY Period Label]
			    )
			VAR _topTier =
			    TOPN ( 1, VALUES ( Dim_Customers[customer_tier] ), [Net Transaction Value], DESC )
			VAR _topShare =
			    DIVIDE ( CALCULATE ( [Net Transaction Value], _topTier ), _cur )
			VAR _second =
			    IF (
			        HASONEVALUE ( Dim_Customers[customer_tier] ),
			        "repeat buyers bring " & FORMAT ( [Repeat Customer Value Share %], "0%" ) & " of it",
			        MAXX ( _topTier, Dim_Customers[customer_tier] ) & " customers bring "
			            & FORMAT ( _topShare, "0%" ) & " of it"
			    )
			RETURN
			    IF ( NOT ISBLANK ( _cur ), _first & "; " & _second )
		displayFolder: 4 Titles
		lineageTag: 8dad7b53-208a-46f7-adcc-2ca122681384

	measure 'Top Category Title' =
			VAR _ranked = TOPN ( 2, ALLSELECTED ( Dim_Products[category] ), [Net Transaction Value], DESC )
			VAR _top = TOPN ( 1, _ranked, [Net Transaction Value], DESC )
			VAR _topValue = MAXX ( _ranked, [Net Transaction Value] )
			VAR _secondValue = MINX ( _ranked, [Net Transaction Value] )
			VAR _share = DIVIDE ( _topValue, CALCULATE ( [Net Transaction Value], ALLSELECTED ( Dim_Products[category] ) ) )
			RETURN
			    MAXX ( _top, Dim_Products[category] ) & " is " & FORMAT ( _share, "0%" )
			        & " of revenue, " & FORMAT ( DIVIDE ( _topValue, _secondValue ), "0" ) & "× the next category"
		displayFolder: 4 Titles
		lineageTag: 6b76881a-3906-409f-a8e8-59b35c543261

	measure 'Platinum Title' =
			"Platinum is " & FORMAT ( [Platinum Share of Customers], "0%" )
			    & " of customers but " & FORMAT ( [Platinum Share of Revenue], "0%" ) & " of revenue"
		displayFolder: 4 Titles
		lineageTag: 9096c095-98b5-49d7-8c43-511f7d33320d

	measure 'Retention Headline' =
			
			IF (
			    NOT ISBLANK ( [Total Customers] ),
			    "Repeat buyers are " & FORMAT ( [Repeat Customer Rate], "0%" )
			        & " of customers and account for " & FORMAT ( [Repeat Customer Value Share %], "0%" ) & " of revenue"
			)
		displayFolder: 4 Titles
		lineageTag: cd099964-0041-4d4f-8e36-c5b6ffa078f4

	measure 'Operations Headline' =
			"1 in " & FORMAT ( DIVIDE ( 1, [Lost Order Rate] ), "0" )
			    & " orders is cancelled or returned: ₹" & FORMAT ( DIVIDE ( [Lost Order Value], 1e6 ), "#,0" ) & "M of order value"
		displayFolder: 4 Titles
		lineageTag: cb026f3b-7c83-45de-ae2e-49fcb03aa4d3

	measure 'Growth Headline' =
			VAR _levers = ADDCOLUMNS ( ALL ( 'Growth Levers' ), "@uplift", [Lever Uplift] )
			VAR _top = TOPN ( 1, _levers, [@uplift], DESC )
			RETURN
			    MAXX ( _top, 'Growth Levers'[Short Name] ) & " is the biggest lever: ₹"
			        & FORMAT ( MAXX ( _top, [@uplift] ) / 1e6, "#,0.0" ) & "M of the ₹"
			        & FORMAT ( [Total Uplift] / 1e6, "#,0.0" ) & "M on the table"
		displayFolder: 4 Titles
		lineageTag: 3927f7ae-ea8c-4b37-96a8-f6c194eeaab1

