	measure 'NTV YoY Label' =
			
			VAR _cap = EDATE ( [Last Sale Date], -12 )
			VAR _cs = [Comparable Start]
			VAR _cur = CALCULATE ( [Net Transaction Value], KEEPFILTERS ( Dim_Date[Date] >= _cs ) )
			VAR _py = CALCULATE ( [Net Transaction Value], SAMEPERIODLASTYEAR ( Dim_Date[Date] ), KEEPFILTERS ( Dim_Date[Date] <= _cap ) )
			RETURN
			    IF ( NOT ISBLANK ( _py ), FORMAT ( DIVIDE ( _cur - _py, _py ), "▲ 0.0%;▼ 0.0%;— 0.0%" ) & " " & [PY Period Label] )
		displayFolder: 2 KPI labels
		lineageTag: 0a7435dd-edf4-43a8-8646-b99d2a719504

	measure 'Orders YoY Label' =
			
			VAR _cap = EDATE ( [Last Sale Date], -12 )
			VAR _cs = [Comparable Start]
			VAR _cur = CALCULATE ( [Total Orders], KEEPFILTERS ( Dim_Date[Date] >= _cs ) )
			VAR _py = CALCULATE ( [Total Orders], SAMEPERIODLASTYEAR ( Dim_Date[Date] ), KEEPFILTERS ( Dim_Date[Date] <= _cap ) )
			RETURN
			    IF ( NOT ISBLANK ( _py ), FORMAT ( DIVIDE ( _cur - _py, _py ), "▲ 0.0%;▼ 0.0%;— 0.0%" ) & " " & [PY Period Label] )
		displayFolder: 2 KPI labels
		lineageTag: e0d30e0f-5387-4eb2-97fa-a71cc08b8ecf

