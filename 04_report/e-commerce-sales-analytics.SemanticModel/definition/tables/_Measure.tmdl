			        Dim_Date[Date],
			        -1,
			        MONTH
			    )
			)
		formatString: "₹"\ #,0.00;#,0.00\ -"₹";"₹"\ #,0.00
		lineageTag: 03d0540f-26fd-4abc-98e6-e882e832e712

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'Previous Year Value' =
			
