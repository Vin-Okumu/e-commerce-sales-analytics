	measure 'Electronics-Only Buyers' =
			COUNTROWS (
			    FILTER (
			        VALUES ( Fact_Sales[customer_id] ),
			        CALCULATE ( [Total Orders], Dim_Products[category] = "Electronics" ) > 0
			            && CALCULATE ( [Total Orders], Dim_Products[category] <> "Electronics" ) = 0
			    )
