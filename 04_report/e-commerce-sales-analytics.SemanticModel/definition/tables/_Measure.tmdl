	measure 'Lever Pool' =
			SWITCH (
			    SELECTEDVALUE ( 'Growth Levers'[Lever] ),
			    "Second purchase from one-time buyers", [One-Time Customers],
			    "Platinum churn avoided", [Platinum Customers],
			    "Home cross-sell to Electronics-only buyers", [Electronics-Only Buyers]
			)
		formatString: #,0
		displayFolder: 5 Growth what-if
		lineageTag: c5ce9a0e-7289-48eb-aa36-86572b90a6d8

	measure 'Lever Assumption' =
			SWITCH (
			    SELECTEDVALUE ( 'Growth Levers'[Lever] ),
			    "Second purchase from one-time buyers", [Second Order Conversion Value],
			    "Platinum churn avoided", [Platinum Churn Avoided Value],
			    "Home cross-sell to Electronics-only buyers", [Home Attach Rate Value]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 5 Growth what-if
		lineageTag: 989a4875-fa60-4010-a8db-7ce9116491e4

	measure 'Lever Value Each (₹K)' =
			DIVIDE ( SWITCH (
			    SELECTEDVALUE ( 'Growth Levers'[Lever] ),
			    "Second purchase from one-time buyers", [Average Order Value],
			    "Platinum churn avoided", [Platinum Value per Customer],
			    "Home cross-sell to Electronics-only buyers", [Avg Home Order Value]
			), 1e3 )
		formatString: \₹#,0.0\K
		displayFolder: 5 Growth what-if
		lineageTag: bcbfbe3d-1c19-4081-810b-a204487e7960

	measure 'Comparable Start' =
			
			EDATE ( CALCULATE ( MIN ( Fact_Sales[order_date] ), REMOVEFILTERS () ), 12 )
		formatString: General Date
		displayFolder: 0 Comparison
		lineageTag: 02c90756-8e22-4c21-a403-65d813a60f44

	measure 'Selected Period Text' =
			
			VAR _start = MIN ( Fact_Sales[order_date] )
			VAR _end = MAX ( Fact_Sales[order_date] )
			RETURN
			    IF (
			        NOT ISBLANK ( _start ),
			        IF ( YEAR ( _start ) = YEAR ( _end ), FORMAT ( _start, "mmm" ), FORMAT ( _start, "mmm yyyy" ) )
			            & "–" & FORMAT ( _end, "mmm yyyy" )
			    )
		displayFolder: 0 Comparison
		lineageTag: ab847c58-f861-4f7e-9d00-07d9b1b999c1

	measure 'Trend Title' =
			
			VAR _cap = EDATE ( [Last Sale Date], -12 )
			VAR _months =
			    ADDCOLUMNS (
			        SUMMARIZE ( Fact_Sales, Dim_Date[Year], Dim_Date[Month Number] ),
			        "@cur", [Net Transaction Value],
			        "@py", CALCULATE ( [Net Transaction Value], SAMEPERIODLASTYEAR ( Dim_Date[Date] ), KEEPFILTERS ( Dim_Date[Date] <= _cap ) )
			    )
			VAR _compared = FILTER ( _months, NOT ISBLANK ( [@py] ) )
			VAR _total = COUNTROWS ( _compared )
			VAR _beat = COUNTROWS ( FILTER ( _compared, [@cur] > [@py] ) )
			RETURN
			    IF (
			        _total > 0,
			        "Revenue beat the same month last year in " & _beat & " of " & _total & " months",
			        "Monthly revenue, " & [Selected Period Text]
			    )
		displayFolder: 4 Titles
		lineageTag: 5b525c7b-b957-4ec3-880d-4a9dd31c63fe

	measure 'Action Second Order' =
			
			"1. Win the second order: " & FORMAT ( [One-Time Customers] / 1e3, "#,0.0" ) & "K one-time buyers this period"
		displayFolder: 0 Comparison
		lineageTag: a7e53e48-0862-4af7-85a2-156171a1dfcf

	measure 'Action Protect Platinum' =
			
			"2. Protect Platinum: each 1 pp of Platinum churn ≈ ₹"
			    & FORMAT ( [Platinum Customers] * 0.01 * [Platinum Value per Customer] / 1e6, "#,0.0" ) & "M"
		displayFolder: 0 Comparison
		lineageTag: 5f4924ed-7211-4c84-9f5a-eaef7a33eeb7

	measure 'Action Cross-sell' =
			
			"3. Cross-sell Home and Sports to " & FORMAT ( [Electronics-Only Buyers] / 1e3, "#,0.0" )
			    & "K Electronics-only buyers"
		displayFolder: 0 Comparison
		lineageTag: b810326f-e129-4f11-bff0-3c19c5f076d3

	measure 'Footer Text' =
			
			"Source: Fact_Sales (250,000 orders, Jun 2024–Jun 2026) · Showing " & [Selected Period Text]
			    & IF ( NOT ISBLANK ( [PY Period Label] ), " " & [PY Period Label] )
			    & " · Values in ₹, excl. cost of goods"
		displayFolder: 3 Formatting
		lineageTag: ad4310d7-940c-4483-a127-f9946da4d625

	measure 'Products Headline' =
			
			VAR _all = FILTER ( ALLSELECTED ( Dim_Products[category] ), NOT ISBLANK ( [Net Transaction Value] ) )
			VAR _rev = CALCULATE ( [Net Transaction Value], _all )
			VAR _units = CALCULATE ( [Units Sold], _all )
			VAR _cats =
			    ADDCOLUMNS (
			        _all,
			        "@rev", DIVIDE ( [Net Transaction Value], _rev ),
			        "@units", DIVIDE ( [Units Sold], _units ),
			        "@aov", [Average Order Value]
			    )
			VAR _gap = TOPN ( 1, FILTER ( _cats, [@units] > [@rev] ), [@units] - [@rev], DESC )
			VAR _top = TOPN ( 1, _cats, [@rev], DESC )
			VAR _first =
			    MAXX ( _top, Dim_Products[category] ) & " earns " & FORMAT ( MAXX ( _top, [@rev] ), "0%" )
			        & " of revenue from " & FORMAT ( MAXX ( _top, [@units] ), "0%" ) & " of units sold"
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _rev ), BLANK (),
			        COUNTROWS ( _cats ) = 1,
			            MAXX ( _cats, Dim_Products[category] ) & " only: " & [NTV Text] & " from "
			                & FORMAT ( _units, "#,0" ) & " units sold",
			        ISEMPTY ( _gap ), _first,
			        _first & "; " & MAXX ( _gap, Dim_Products[category] ) & " sells "
			            & FORMAT ( MAXX ( _gap, [@units] ), "0%" ) & " of units for "
			            & FORMAT ( MAXX ( _gap, [@rev] ), "0%" ) & " of revenue"
			    )
		displayFolder: 4 Titles
		lineageTag: 65383bfb-627a-4049-bd8a-48aac18fc726

	measure 'Volume Value Title' =
			
			VAR _all = FILTER ( ALLSELECTED ( Dim_Products[category] ), NOT ISBLANK ( [Net Transaction Value] ) )
			VAR _rev = CALCULATE ( [Net Transaction Value], _all )
			VAR _units = CALCULATE ( [Units Sold], _all )
			VAR _cats =
			    ADDCOLUMNS (
			        _all,
			        "@rev", DIVIDE ( [Net Transaction Value], _rev ),
			        "@units", DIVIDE ( [Units Sold], _units ),
			        "@aov", [Average Order Value]
			    )
			VAR _gap = TOPN ( 1, FILTER ( _cats, [@units] > [@rev] ), [@units] - [@rev], DESC )
			RETURN
			    IF (
			        ISEMPTY ( _gap ),
			        "Units and revenue are shared out similarly across categories",
			        MAXX ( _gap, Dim_Products[category] ) & " is " & FORMAT ( MAXX ( _gap, [@units] ), "0%" )
			            & " of units sold but only " & FORMAT ( MAXX ( _gap, [@rev] ), "0%" ) & " of revenue"
			    )
		displayFolder: 4 Titles
		lineageTag: 410dabef-88b9-46eb-b0b7-337e985c0235

	measure 'Category AOV Title' =
			
			VAR _all = FILTER ( ALLSELECTED ( Dim_Products[category] ), NOT ISBLANK ( [Net Transaction Value] ) )
			VAR _rev = CALCULATE ( [Net Transaction Value], _all )
			VAR _units = CALCULATE ( [Units Sold], _all )
			VAR _cats =
			    ADDCOLUMNS (
			        _all,
			        "@rev", DIVIDE ( [Net Transaction Value], _rev ),
			        "@units", DIVIDE ( [Units Sold], _units ),
			        "@aov", [Average Order Value]
			    )
			VAR _gap = TOPN ( 1, FILTER ( _cats, [@units] > [@rev] ), [@units] - [@rev], DESC )
			VAR _hi = TOPN ( 1, _cats, [@aov], DESC )
			VAR _lowest = TOPN ( 1, _cats, [@aov], ASC )
			VAR _useGap = NOT ISEMPTY ( _gap )
			VAR _hiName = MAXX ( _hi, Dim_Products[category] )
			VAR _loName = IF ( _useGap, MAXX ( _gap, Dim_Products[category] ), MAXX ( _lowest, Dim_Products[category] ) )
			VAR _loAov = IF ( _useGap, MAXX ( _gap, [@aov] ), MAXX ( _lowest, [@aov] ) )
			VAR _article = IF ( LEFT ( _hiName, 1 ) IN { "A", "E", "I", "O", "U" }, "An ", "A " )
			VAR _article2 = IF ( LEFT ( _loName, 1 ) IN { "A", "E", "I", "O", "U" }, "an ", "a " )
			RETURN
			    IF (
			        COUNTROWS ( _cats ) > 1,
			        _article & _hiName & " order is worth " & FORMAT ( DIVIDE ( MAXX ( _hi, [@aov] ), _loAov ), "0" )
			            & "× " & _article2 & _loName & " order",
			        "Average order value by category"
			    )
		displayFolder: 4 Titles
		lineageTag: e5a2086d-0ed1-41c7-8673-5934808d5caa

	measure 'Top Products Title' =
			
			VAR _products =
			    FILTER ( ALLSELECTED ( Dim_Products[product_name] ), NOT ISBLANK ( [Net Transaction Value] ) )
			VAR _top10 = TOPN ( 10, _products, [Net Transaction Value], DESC )
			VAR _leader = MAXX ( TOPN ( 1, _top10, [Net Transaction Value], DESC ), Dim_Products[product_name] )
			VAR _cats = CALCULATETABLE ( VALUES ( Dim_Products[category] ), _top10 )
			VAR _n = COUNTROWS ( _cats )
			RETURN
			    IF (
			        _n = 1,
			        "All top-10 product lines are " & MAXX ( _cats, Dim_Products[category] ) & ", led by " & _leader,
			        "The top-10 product lines span " & _n & " categories, led by " & _leader
			    )
		displayFolder: 4 Titles
		lineageTag: 2bd5a55c-dc44-40ac-a44d-52a72dc13545

	measure 'Customers Headline' =
			
			VAR _tiers =
			    ADDCOLUMNS (
			        FILTER ( ALLSELECTED ( Dim_Customers[customer_tier] ), NOT ISBLANK ( [Value per Customer] ) ),
			        "@vpc", [Value per Customer]
			    )
			VAR _top = TOPN ( 1, _tiers, [@vpc], DESC )
			VAR _topName = MAXX ( _top, Dim_Customers[customer_tier] )
			VAR _topVpc = MAXX ( _top, [@vpc] )
			VAR _others = FILTER ( _tiers, Dim_Customers[customer_tier] <> _topName )
			VAR _article = IF ( LEFT ( _topName, 1 ) IN { "A", "E", "I", "O", "U" }, "An ", "A " )
			VAR _comparisons =
			    CONCATENATEX (
			        _others,
			        FORMAT ( DIVIDE ( _topVpc, [@vpc] ), "0" ) & "× "
			            & IF ( LEFT ( Dim_Customers[customer_tier], 1 ) IN { "A", "E", "I", "O", "U" }, "an ", "a " )
			            & Dim_Customers[customer_tier],
			        " and ",
			        [@vpc], DESC
			    )
			RETURN
			    IF (
			        NOT ISEMPTY ( _tiers ),
			        _article & _topName & " customer is worth ₹" & FORMAT ( _topVpc / 1e3, "#,0.0" ) & "K"
			            & IF ( NOT ISEMPTY ( _others ), ": " & _comparisons & " customer", " this period" )
			    )
		displayFolder: 4 Titles
		lineageTag: 17c01b8c-9d11-432b-a196-64a2621c26ef

	measure 'Tier Value Title' =
			
			VAR _tiers =
			    ADDCOLUMNS (
			        FILTER ( ALLSELECTED ( Dim_Customers[customer_tier] ), NOT ISBLANK ( [Value per Customer] ) ),
			        "@vpc", [Value per Customer]
			    )
			VAR _top = TOPN ( 1, _tiers, [@vpc], DESC )
			VAR _value = "₹" & FORMAT ( MAXX ( _top, [@vpc] ) / 1e3, "#,0.0" ) & "K"
			RETURN
			    IF (
			        COUNTROWS ( _tiers ) > 1,
			        MAXX ( _top, Dim_Customers[customer_tier] ) & " customers are worth the most, each worth " & _value,
			        MAXX ( _tiers, Dim_Customers[customer_tier] ) & " customers are worth " & _value & " each"
			    )
		displayFolder: 4 Titles
		lineageTag: f97ccec7-7b27-445c-b401-aa2160a5a4e7

	measure 'Age Title' =
			
			VAR _total = CALCULATE ( [Net Transaction Value], ALLSELECTED ( Dim_Customers[age_group] ) )
			VAR _ages =
			    ADDCOLUMNS (
			        FILTER ( ALLSELECTED ( Dim_Customers[age_group] ), NOT ISBLANK ( [Net Transaction Value] ) ),
			        "@share", DIVIDE ( [Net Transaction Value], _total )
			    )
			VAR _top = TOPN ( 1, _ages, [@share], DESC )
			VAR _topName = SUBSTITUTE ( CONCATENATEX ( _top, Dim_Customers[age_group] ), "-", "–" )
			VAR _young = TOPN ( 3, _ages, Dim_Customers[age_group], ASC )
			VAR _youngLabel =
			    LEFT ( CONCATENATEX ( TOPN ( 1, _young, Dim_Customers[age_group], ASC ), Dim_Customers[age_group] ), 2 ) & "–"
			        & RIGHT ( CONCATENATEX ( TOPN ( 1, _young, Dim_Customers[age_group], DESC ), Dim_Customers[age_group] ), 2 )
			VAR _first = _topName & "-year-olds bring " & FORMAT ( MAXX ( _top, [@share] ), "0%" ) & " of revenue"
			RETURN
			    SWITCH (
			        TRUE (),
			        ISEMPTY ( _ages ), BLANK (),
			        COUNTROWS ( _ages ) = 1, "Revenue from " & _topName & "-year-olds only",
			        COUNTROWS ( _ages ) > 3,
			            _first & "; " & _youngLabel & "-year-olds bring " & FORMAT ( SUMX ( _young, [@share] ), "0%" ),
			        _first
			    )
		displayFolder: 4 Titles
		lineageTag: 6d8483fa-e98a-42aa-8748-8f295c71ac9f

	measure 'Repeat Tier Title' =
			
			VAR _tiers =
			    ADDCOLUMNS (
			        FILTER ( ALLSELECTED ( Dim_Customers[customer_tier] ), NOT ISBLANK ( [Repeat Customer Rate] ) ),
			        "@rate", [Repeat Customer Rate]
			    )
			VAR _hi = TOPN ( 1, _tiers, [@rate], DESC )
			VAR _lo = TOPN ( 1, _tiers, [@rate], ASC )
			RETURN
			    IF (
			        COUNTROWS ( _tiers ) > 1,
			        MAXX ( _hi, Dim_Customers[customer_tier] ) & " buyers return most often (" & FORMAT ( MAXX ( _hi, [@rate] ), "0%" )
			            & "); " & MAXX ( _lo, Dim_Customers[customer_tier] ) & " buyers return least ("
			            & FORMAT ( MAXX ( _lo, [@rate] ), "0%" ) & ")",
			        "Repeat rate: " & FORMAT ( MAXX ( _tiers, [@rate] ), "0%" )
			    )
		displayFolder: 4 Titles
		lineageTag: f4f8d64f-473e-48f1-8bae-012d347dc25a

	measure 'Repeat Value Title' =
			
			VAR _repeatEach = DIVIDE ( [Repeat Customer Value], [Repeat Customers] )
			VAR _oneTimeEach = DIVIDE ( [One-Time Customer Value], [One-Time Customers] )
			RETURN
			    IF (
			        NOT ISBLANK ( _repeatEach ) && NOT ISBLANK ( _oneTimeEach ),
			        "Each repeat buyer is worth " & FORMAT ( DIVIDE ( _repeatEach, _oneTimeEach ), "0.0" ) & "× a one-time buyer",
			        "Repeat vs one-time buyers"
			    )
		displayFolder: 4 Titles
		lineageTag: a8a44a57-c60e-40ed-86a0-f096049c7e4a

	measure 'Least Loyal Title' =
			
			VAR _tiers =
			    ADDCOLUMNS (
			        FILTER ( ALLSELECTED ( Dim_Customers[customer_tier] ), NOT ISBLANK ( [Repeat Customer Rate] ) ),
			        "@rate", [Repeat Customer Rate]
			    )
			VAR _lo = TOPN ( 1, _tiers, [@rate], ASC )
			VAR _hi = TOPN ( 1, _tiers, [@rate], DESC )
			RETURN
			    IF (
			        COUNTROWS ( _tiers ) > 1,
			        MAXX ( _lo, Dim_Customers[customer_tier] ) & " is the least loyal tier: "
			            & FORMAT ( MAXX ( _lo, [@rate] ), "0%" ) & " bought again vs "
			            & FORMAT ( MAXX ( _hi, [@rate] ), "0%" ) & " for " & MAXX ( _hi, Dim_Customers[customer_tier] ),
			        MAXX ( _tiers, Dim_Customers[customer_tier] ) & ": " & FORMAT ( MAXX ( _tiers, [@rate] ), "0%" )
			            & " of customers bought again"
			    )
		displayFolder: 4 Titles
		lineageTag: f8b2bc42-bdfa-4bb4-990c-52bf9e00beee

	measure 'Monthly Repeat Title' =
			
			VAR _months =
			    ADDCOLUMNS (
			        SUMMARIZE ( Fact_Sales, Dim_Date[Year], Dim_Date[Month Number] ),
			        "@rate", [Repeat Customer Rate]
			    )
			VAR _min = MINX ( _months, [@rate] )
			VAR _max = MAXX ( _months, [@rate] )
			VAR _first = MAXX ( TOPN ( 1, _months, Dim_Date[Year], ASC, Dim_Date[Month Number], ASC ), [@rate] )
			VAR _last = MAXX ( TOPN ( 1, _months, Dim_Date[Year], DESC, Dim_Date[Month Number], DESC ), [@rate] )
			RETURN
			    SWITCH (
			        TRUE (),
			        COUNTROWS ( _months ) < 2, "Within-month repeat buying",
			        _max - _min < 0.02,
			            "Within-month repeat buying is steady at " & FORMAT ( _min, "0.0%" ) & "–" & FORMAT ( _max, "0.0%" )
			                & ": no sign of a loyalty slide",
			        _last < _first,
			            "Within-month repeat buying fell from " & FORMAT ( _first, "0.0%" ) & " to " & FORMAT ( _last, "0.0%" ),
			        "Within-month repeat buying rose from " & FORMAT ( _first, "0.0%" ) & " to " & FORMAT ( _last, "0.0%" )
			    )
		displayFolder: 4 Titles
		lineageTag: f95d158d-64b7-496c-b4ad-376e6993cd30

	measure 'Monthly Repeat Subtitle' =
			
			"Share of each month's customers who ordered 2+ times in that month. A monthly measure, so lower than the "
			    & FORMAT ( [Repeat Customer Rate], "0.0%" ) & " period rate (axis starts at zero)"
		displayFolder: 4 Titles
		lineageTag: 591949e9-8bb5-424c-8796-fb08a6d692a1

	column Measure
		isHidden
		formatString: 0
		lineageTag: a6115bdf-8221-4758-923c-dce341da3d94
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Measure]

		annotation SummarizationSetBy = Automatic

	partition _Measure = calculated
		mode: import
		source = Row("Measure", BLANK())

	annotation PBI_Id = 725e37b1f29642f08b6a43851c11244b

