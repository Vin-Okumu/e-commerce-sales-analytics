	measure 'Last Sale Date' = CALCULATE ( MAX ( Fact_Sales[order_date] ), REMOVEFILTERS () )
		formatString: d mmm yyyy
		displayFolder: 0 Comparison
		lineageTag: 9cbc1723-f80e-4fd3-a5c1-7b90b66661d0

	measure 'PY Period Label' =
			
			VAR _cap = EDATE ( [Last Sale Date], -12 )
			VAR _dates =
			    CALCULATETABLE (
			        VALUES ( Dim_Date[Date] ),
			        SAMEPERIODLASTYEAR ( Dim_Date[Date] ),
			        KEEPFILTERS ( Dim_Date[Date] <= _cap )
			    )
			VAR _start = MINX ( _dates, Dim_Date[Date] )
			VAR _end = MAXX ( _dates, Dim_Date[Date] )
			VAR _partial = MIN ( Fact_Sales[order_date] ) < [Comparable Start]
			RETURN
			    IF (
			        NOT ISBLANK ( _start ),
			        "vs "
			            & IF ( YEAR ( _start ) = YEAR ( _end ), FORMAT ( _start, "mmm" ), FORMAT ( _start, "mmm yyyy" ) )
			            & "–" & FORMAT ( _end, "mmm yyyy" )
			            & IF ( _partial, " (same months)" )
			    )
		displayFolder: 0 Comparison
		lineageTag: 8fcfaa32-1ebc-4488-a0da-8a9932d1cfbe

	measure 'Net Transaction Value PY' =
			VAR _cap = EDATE ( [Last Sale Date], -12 )
			RETURN
			    CALCULATE ( [Net Transaction Value], SAMEPERIODLASTYEAR ( Dim_Date[Date] ), KEEPFILTERS ( Dim_Date[Date] <= _cap ) )
		formatString: "₹"\ #,0.00;#,0.00\ -"₹";"₹"\ #,0.00
		displayFolder: 0 Comparison
		lineageTag: 89fe7e73-1f7a-4056-a3e5-869ae66f84e1

	measure 'Lost Orders' = CALCULATE ( [Total Orders], Fact_Sales[order_status] IN { "Cancelled", "Returned" } )
